# 🛡️ Sentinel: Secure-by-default .gitignore for AI-generated projects
# To prevent accidental leakage of API keys, credentials, and build dependencies.

# Environments & Sensitive Secrets
.env
.env.local
.env.*.local
*.env
local.properties
*.keystore
*.jks
*.p12
*.pem
*.pkcs12
secrets.xml

# Android & Gradle Build Artifacts
.gradle/
build/
app/build/
android/build/
android/app/build/
captures/
*.apk
*.ap_
*.aab
*.dex
*.class

# Node / Web Build & Dependencies
node_modules/
dist/
out/
.next/
.nuxt/
.svelte-kit/
pnpm-lock.yaml
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDEs & System Files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
